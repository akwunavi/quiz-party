 "shift": {
  "units": "source px of the 1276x720 frame, positive = sprite to the right; canvas px = src px x spriteWidth/1276",
  "mode": "native",
  "arraysFile": "frenk_start_shift_arrays.json",
  "stopArraysFile": "frenk_stop_v4_shift_arrays.json",
  "rules": {
   "STOP": "during STOP and FINISH_DECELERATE: stopShiftSrc[category of the STOP segment base][frame index of the STOP clip]",
   "stationary": "BASE, BUTTERFLY, ROLL, SNIFF_PEE, RETURN: stationaryShiftSrc of the category of the LAST finished STOP/FINISH_DECELERATE; before the first STOP (initial BASE, events from BASE): 0",
   "START": "native START array C[category of the START] x (offset + 125)/125, offset = stationary shift in force before this START (the START item may begin up to lead=3 frames before the physical START)",
   "RUN": "0",
   "categories": "by segment base: VERY_FAST 1.25, FAST 1.12, NORMAL 1.0, SLOW 0.88, VERY_SLOW 0.75 (categoryOf in race-v3-p3-lab/src/visual.mjs)"
  }
 },
 "shadow": {
  "rule": "the shadow follows the VISIBLE body, not the sprite box",
  "ellipse": {
   "rx": 59,
   "ry": 5,
   "dyFromLane": 2,
   "fill": "rgba(28,45,35,.37)",
   "note": "same ellipse as Bulldog No.4"
  },
  "x": "shadowX = engineX - 50 + shiftSrc*spriteWidth/1276 + (ref(label) - runMean)*spriteWidth/atlas.cellWidth",
  "runMean": "mean alpha centroid (atlas cx) of the RUN cycle labels START.loop: in RUN the shadow is exactly Bulldog No.4 (anchor - 50)",
  "standRef": {
   "labels": "RACE_STAND and all labels of SNIFF_PEE and BUTTERFLY",
   "ref": "cx of RACE_STAND (feet are planted, the shadow does not slide)"
  },
  "smoothed": {
   "clips": [
    "START (non-RUN labels)",
    "STOP (without RACE_STAND)",
    "ROLL"
   ],
   "window": 5,
   "note": "own centroid, centred moving average over 5 frames along the clip order"
  },
  "stopEntryBlendFrames": 8,
  "stopEntryBlend": "first 8 STOP labels: ref += (runMean - stopShiftSrc.NORMAL[0]*cellWidth/1276 - ref(first)) * (1 - smoothstep(i/8))",
  "rollEdgeBlendFrames": 6,
  "rollEdgeBlend": "ROLL labels: ref = smooth(i) + (standCx - smooth(0))*max(0,1-i/6) + (standCx - smooth(n-1))*max(0,1-(n-1-i)/6)"
 },

{
  "name": "quiz-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy:prep": "npm run build && rm -rf docs && cp -r dist docs",
    "lab": "vite --open /quiz-party/labs/newyear/",
    "lab:build": "node scripts/build-ny-lab.mjs",
    "lab:magic": "vite --open /quiz-party/labs/magic2/",
    "lab:magic:build": "node scripts/build-magic-lab.mjs",
    "lab:worlds": "vite --open /quiz-party/labs/worlds7/",
    "lab:worlds:build": "node scripts/build-worlds-lab.mjs",
    "lab:cine": "vite --open /quiz-party/labs/cine7/",
    "lab:cine:build": "node scripts/build-cine-lab.mjs",
    "lab:forest": "vite --open /quiz-party/labs/forest/",
    "lab:forest:build": "node scripts/build-forest-lab.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "gsap": "^3.15.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
